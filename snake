<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>貪食蛇 Snake</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #f5f5f0;
      color: #333333;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }
    .game-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      width: 400px;
      font-size: 1.25rem;
      font-weight: bold;
    }
    canvas {
      background-color: #f0f0eb;
      border: 2px solid #333333;
    }
    .overlay {
      position: absolute;
      width: 400px;
      height: 400px;
      background-color: rgba(245, 245, 240, 0.85);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }
    .overlay h2 {
      font-size: 2rem;
    }
    .overlay p {
      font-size: 1.2rem;
    }
    .btn {
      margin-top: 8px;
      padding: 8px 20px;
      font-size: 1rem;
      font-weight: bold;
      color: #f5f5f0;
      background-color: #333333;
      border: none;
      cursor: pointer;
    }
    .btn:hover {
      background-color: #555555;
    }
    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>

  <div class="game-container">
    <div class="header">
      <div>SCORE: <span id="score">0</span></div>
      <div>HIGH: <span id="high-score">0</span></div>
    </div>

    <div style="position: relative;">
      <canvas id="gameCanvas" width="400" height="400"></canvas>
      
      <div id="startOverlay" class="overlay">
        <h2>貪食蛇</h2>
        <p>使用方向鍵 ↑ ↓ ← → 控制</p>
        <button class="btn" onclick="startGame()">開始遊戲</button>
      </div>

      <div id="gameOverOverlay" class="overlay hidden">
        <h2>GAME OVER</h2>
        <p>最終分數：<span id="finalScore">0</span></p>
        <button class="btn" onclick="startGame()">再試一次</button>
      </div>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreElement = document.getElementById('score');
    const highScoreElement = document.getElementById('high-score');
    const finalScoreElement = document.getElementById('finalScore');
    const startOverlay = document.getElementById('startOverlay');
    const gameOverOverlay = document.getElementById('gameOverOverlay');

    const gridSize = 20;
    const tileCount = canvas.width / gridSize;

    let snake = [];
    let food = { x: 0, y: 0 };
    let dx = gridSize;
    let dy = 0;
    let score = 0;
    let highScore = 0;
    let gameInterval = null;
    let isChangingDirection = false;

    function startGame() {
      snake = [
        { x: 160, y: 200 },
        { x: 140, y: 200 },
        { x: 120, y: 200 }
      ];
      dx = gridSize;
      dy = 0;
      score = 0;
      scoreElement.textContent = score;

      startOverlay.classList.add('hidden');
      gameOverOverlay.classList.add('hidden');

      spawnFood();

      if (gameInterval) clearInterval(gameInterval);
      gameInterval = setInterval(gameLoop, 100);
    }

    function gameLoop() {
      if (hasGameEnded()) {
        endGame();
        return;
      }

      isChangingDirection = false;
      clearCanvas();
      drawFood();
      moveSnake();
      drawSnake();
    }

    function clearCanvas() {
      ctx.fillStyle = '#f0f0eb';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.strokeStyle = '#e2e2dc';
      ctx.lineWidth = 1;
      for (let i = 0; i < canvas.width; i += gridSize) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, canvas.height);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(canvas.width, i);
        ctx.stroke();
      }
    }

    function drawSnake() {
      snake.forEach((part, index) => {
        ctx.fillStyle = '#333333';
        ctx.fillRect(part.x + 1, part.y + 1, gridSize - 2, gridSize - 2);
      });
    }

    function moveSnake() {
      const head = { x: snake[0].x + dx, y: snake[0].y + dy };
      snake.unshift(head);

      if (head.x === food.x && head.y === food.y) {
        score += 10;
        scoreElement.textContent = score;
        if (score > highScore) {
          highScore = score;
          highScoreElement.textContent = highScore;
        }
        spawnFood();
      } else {
        snake.pop();
      }
    }

    function spawnFood() {
      while (true) {
        food.x = Math.floor(Math.random() * tileCount) * gridSize;
        food.y = Math.floor(Math.random() * tileCount) * gridSize;

        let collision = snake.some(part => part.x === food.x && part.y === food.y);
        if (!collision) break;
      }
    }

    function drawFood() {
      ctx.fillStyle = '#666666';
      ctx.fillRect(food.x + 2, food.y + 2, gridSize - 4, gridSize - 4);
    }

    function hasGameEnded() {
      const head = snake[0];

      const hitLeft = head.x < 0;
      const hitRight = head.x >= canvas.width;
      const hitTop = head.y < 0;
      const hitBottom = head.y >= canvas.height;

      if (hitLeft || hitRight || hitTop || hitBottom) return true;

      for (let i = 1; i < snake.length; i++) {
        if (head.x === snake[i].x && head.y === snake[i].y) return true;
      }

      return false;
    }

    function endGame() {
      clearInterval(gameInterval);
      finalScoreElement.textContent = score;
      gameOverOverlay.classList.remove('hidden');
    }

    document.addEventListener('keydown', changeDirection);

    function changeDirection(event) {
      const LEFT = 37;
      const UP = 38;
      const RIGHT = 39;
      const DOWN = 40;

      if (isChangingDirection) return;

      const keyPressed = event.keyCode;
      const goingUp = dy === -gridSize;
      const goingDown = dy === gridSize;
      const goingRight = dx === gridSize;
      const goingLeft = dx === -gridSize;

      if (keyPressed === LEFT && !goingRight) {
        dx = -gridSize;
        dy = 0;
        isChangingDirection = true;
      }
      if (keyPressed === UP && !goingDown) {
        dx = 0;
        dy = -gridSize;
        isChangingDirection = true;
      }
      if (keyPressed === RIGHT && !goingLeft) {
        dx = gridSize;
        dy = 0;
        isChangingDirection = true;
      }
      if (keyPressed === DOWN && !goingUp) {
        dx = 0;
        dy = gridSize;
        isChangingDirection = true;
      }
    }

    clearCanvas();
  </script>
</body>
</html>
